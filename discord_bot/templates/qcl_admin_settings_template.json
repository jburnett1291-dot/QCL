{
  "template_version": 1,
  "registration": {
    "socials_required": ["Instagram", "TikTok", "YouTube", "X/Twitter"],
    "form_schemas": {
      "byot_gm": {
        "label": "BYOT GM",
        "fields": ["team_name", "team_logo", "gamertag_or_psn", "platform"]
      },
      "draft_gm": {
        "label": "Draft GM",
        "fields": ["team_name", "team_logo", "gamertag_or_psn", "platform"]
      },
      "draft_player": {
        "label": "Draft Player",
        "fields": ["gamertag_or_psn", "platform", "position", "availability"]
